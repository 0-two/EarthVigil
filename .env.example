# Local: copy to .env.   Vercel: add each one under Project → Settings → Environment Variables.
# Every alert channel is optional: an unconfigured one runs in "dry-run" mode
# (the message is printed to the server log instead of being sent).

# Public address of the site, used in links inside alert messages.
PUBLIC_URL=http://localhost:5173
PORT=8787
ALERT_INTERVAL_MIN=15

# Protects /api/cron/sweep. Any long random string (Vercel Cron and Supabase pg_cron send it).
#   generate one:  node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# ── Database: Supabase (required in production, optional locally) ─────
# Supabase → Project Settings → API: "Project URL" and the "service_role" secret key.
# Never expose the service_role key in the browser: it is only read by the server.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── NASA (optional) ───────────────────────────────────────────────────
# EONET and GIBS need no key, and FIRMS works without one via its public 24 h files.
# A FIRMS MAP_KEY switches to the FIRMS area API: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# ── Email (any SMTP: Resend, Brevo, Postmark, SES, Gmail app password) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VigilEarth <alerts@example.com>"

# ── Telegram (create a bot with @BotFather) ─────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Any random string. Telegram sends it with each webhook call so strangers can't fake updates.
TELEGRAM_WEBHOOK_SECRET=

# ── SMS + WhatsApp via Twilio ───────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# e.g. whatsapp:+14155238886 (Twilio sandbox)
TWILIO_WHATSAPP_FROM=

# Discord and Slack need no server keys: people paste their own incoming-webhook URL.
